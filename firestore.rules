rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Perfis de usuários e salões (Leitura pública para permitir a página de agendamento online)
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Serviços e combos do salão (Leitura pública para agendamento online)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Profissionais e colaboradores (Leitura pública para agendamento online)
    match /professionals/{profId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /employees/{employeeId} {
      allow read, write: if request.auth != null;
    }

    // 4. Clientes do salão (Permite leitura e criação de novas clientes pelo agendamento online)
    match /clients/{clientId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // 5. Agendamentos (Permite agendamento público online de clientes sem login)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // 6. Módulo financeiro e metas
    match /salon_finance/{userId} {
      allow read, write: if request.auth != null;
    }

    // 7. Dados extras (estoque, produtos, cupons, bloqueios)
    match /salon_extras/{userId} {
      allow read, write: if request.auth != null;
    }

    // 8. Configurações da plataforma SaaS
    match /platform_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 9. Configurações e estado de conexão do WhatsApp
    match /whatsapp_config/{userId} {
      allow read, write: if request.auth != null;
    }

    // Regra global de segurança para qualquer coleção nova
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
